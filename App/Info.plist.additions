<!--
  Merge these keys into the Info.plist that Xcode generates when you create
  the project. Xcode 15+ hides Info.plist by default — edit via Target →
  Info tab, or expose the file via "Generate Info.plist File" = NO and
  drop these in manually.
-->

<key>NSCameraUsageDescription</key>
<string>Scan supplement labels to add them automatically.</string>

<key>NSHealthShareUsageDescription</key>
<string>Read age and sex to personalize your recommendations.</string>

<key>NSHealthUpdateUsageDescription</key>
<string>Save your intake to Apple Health.</string>

<key>NSPhotoLibraryUsageDescription</key>
<string>Choose a photo of your supplement from the library.</string>

<key>UIAppFonts</key>
<array>
    <string>InstrumentSerif-Regular.ttf</string>
    <string>InstrumentSerif-Italic.ttf</string>
    <string>Inter-Regular.ttf</string>
    <string>Inter-Medium.ttf</string>
    <string>Inter-SemiBold.ttf</string>
    <string>Inter-Bold.ttf</string>
</array>
